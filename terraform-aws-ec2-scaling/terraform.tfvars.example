# General Configuration
aws_region   = "us-east-1"
project_name = "ec2-scaling-test"
environment  = "test"

# Network Configuration
vpc_cidr = "10.0.0.0/16"
az_count = 2

# EC2 Configuration
instance_type     = "t3.micro"
key_name          = "your-key-pair-name"
root_volume_size  = 20
ssh_allowed_ips   = ["0.0.0.0/0"]

# Auto Scaling Group Configuration
asg_min_size         = 1
asg_max_size         = 20
asg_desired_capacity = 2

# AGGRESSIVE SCALING THRESHOLDS FOR TESTING
# These are set LOW to trigger scaling easily for testing your guardian extension

# Target tracking CPU (will try to maintain this level)
target_cpu_utilization = 30

# Step scaling thresholds
scale_out_cpu_threshold = 40    # Triggers when CPU > 40%
emergency_cpu_threshold = 60    # Triggers emergency scaling at CPU > 60%
scale_in_cpu_threshold  = 15    # Scales in when CPU < 15%

# Step scaling increments (AGGRESSIVE - scales to exact capacity)
scale_out_step_1 = 5   # Scale to 5 instances when CPU is 40-50%
scale_out_step_2 = 10  # Scale to 10 instances when CPU is 50-60%
scale_out_step_3 = 15  # Scale to 15 instances when CPU > 60%

# Emergency scaling (percentage increase)
emergency_scale_percentage = 200  # Doubles the capacity

# Guardian Extension Detection
rapid_scaling_threshold = 8  # Alert when desired capacity exceeds 8 instances

# Network threshold
network_in_threshold = 5000000

# Alert Configuration
alert_email = "your-email@example.com"
